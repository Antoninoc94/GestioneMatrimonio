# Copia questo file in .env e imposta i valori reali
# cp .env.example .env

# OBBLIGATORIO: stringa segreta per JWT (genera con: openssl rand -hex 32)
JWT_SECRET=cambia_questa_stringa_con_qualcosa_di_sicuro

# Porta pubblicata sull'host (default 80). Dietro un reverse proxy
# si usa tipicamente 3001 e il proxy inoltra su questa.
#APP_PORT=3001

# Numero di reverse proxy davanti all'app: 0 = nessuno (default),
# 1 = nginx, 2 = CDN (es. Cloudflare) + nginx.
# Senza questo valore tutti i visitatori risultano avere l'IP del proxy
# e condividono lo stesso contatore di rate limit.
# Non impostarlo piu' alto del numero reale di proxy: renderebbe
# falsificabile l'header X-Forwarded-For.
#TRUST_PROXY=1

# Galleria foto degli invitati: cartella SUL SERVER (es. il mount della NAS) dove
# vanno le foto. Senza, le foto stanno in un volume locale di Docker.
# Con questa impostata l'app scrive solo se nella cartella esiste il file
# .galleria-nas (si crea una volta a mano: protegge dal mount saltato).
#GALLERIA_DIR=/mnt/foto-matrimonio
